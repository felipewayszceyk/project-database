{% extends "base.html" %}

{% block title %} {{ 'Edit Booking' if booking else 'Add Booking' }} {% endblock %}

{% block content %}

<section class="page-header">
    <h1>{{ 'Edit Booking' if booking else 'Add Booking' }}</h1>
    <p>{{ 'Update the booking details' if booking else 'Schedule a service for a client' }}</p>
</section>

<section class="contact-section">

    {% if error %}
    <div class="alert error">{{ error }}</div>
    {% endif %}

    <form method="POST"
          action="{{ url_for('edit_booking', booking_id=booking.id) if booking else url_for('new_booking') }}">

        <div class="form-group">
            <label for="client_id">Client</label>
            <select id="client_id" name="client_id">
                <option value="">Select a client</option>
                {% for client in clients %}
                <option value="{{ client.id }}"
                        {% if booking and booking.client_id == client.id %}selected{% endif %}>
                    {{ client.full_name }}
                </option>
                {% endfor %}
            </select>
        </div>

        <div class="form-group">
            <label for="service_id">Service</label>
            <select id="service_id" name="service_id">
                <option value="">Select a service</option>
                {% for service in services %}
                <option value="{{ service.id }}"
                        {% if booking and booking.service_id == service.id %}selected{% endif %}>
                    {{ service.name }}
                </option>
                {% endfor %}
            </select>
        </div>

        <div class="form-group">
            <label for="scheduled_at">Date and time</label>
            <input type="datetime-local" id="scheduled_at" name="scheduled_at"
                   value="{{ booking.scheduled_at.strftime('%Y-%m-%dT%H:%M') if booking else '' }}">
        </div>

        <div class="form-group">
            <label for="status">Status</label>
            <select id="status" name="status">
                {% for option in ['scheduled', 'completed', 'cancelled'] %}
                <option value="{{ option }}"
                        {% if booking and booking.status == option %}selected{% endif %}>
                    {{ option }}
                </option>
                {% endfor %}
            </select>
        </div>

        <div class="form-group">
            <label for="notes">Notes</label>
            <textarea id="notes" name="notes" rows="3">{{ booking.notes or '' if booking else '' }}</textarea>
        </div>

        <button type="submit" class="btn">{{ 'Save changes' if booking else 'Save Booking' }}</button>
    </form>

</section>

{% endblock %}